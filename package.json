{
  "name": "docweaver",
  "version": "1.0.0",
  "description": "AI驱动的代码库README文档自动生成与同步CLI工具",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "docweaver": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "pretest": "npm run build",
    "test": "jest --no-coverage",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ tests/",
    "format": "prettier --write src/ tests/"
  },
  "keywords": ["readme", "documentation", "ai", "cli", "code-documentation", "readme-generator"],
  "author": "DocWeaver",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^10.2.1",
    "execa": "^9.6.1",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "ts-jest": "^29.4.9",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^14.0.3",
    "diff": "^9.0.0",
    "dotenv": "^17.4.2",
    "fs-extra": "^11.3.4",
    "ignore": "^7.0.5",
    "openai": "^6.35.0",
    "ora": "^9.4.0"
  }
}
